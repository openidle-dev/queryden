---
import Layout from '../layouts/Layout.astro';
import SignatureMesh from '../components/SignatureMesh.astro';
import { SITE, RELEASE } from '../lib/site';

// The structure is informed by Zed ("Currently / Next"), Warp ("team
// committed / community-eligible"), and Astro (issues are the source of
// truth — the website is a thin curated view). Each item should link to a
// GitHub issue when one exists; the issue is what's real, this page is a
// summary. When an issue closes, move its item to SHIPPED.
//
// Status rule (keep it minimal): only "in progress" items get a badge.
// Everything else is implicitly planned. Don't invent dates or version pins.

type Status = 'in-progress' | 'planned' | 'exploring';

interface Item {
  title: string;
  body: string;       // one or two sentences; plain text or simple inline HTML
  issue?: number;     // GitHub issue number; renders as #N → repo link
  status?: Status;    // omit for "planned" in Now/Next; use 'exploring' for Later
}

interface Horizon {
  id: 'now' | 'next' | 'later';
  label: string;
  lede: string;
  items: Item[];
}

const issueLink = (n: number) => `<a href="${SITE.repo}/issues/${n}" rel="noopener">#${n}</a>`;

const HORIZONS: Horizon[] = [
  {
    id: 'now',
    label: 'Now',
    lede: 'Active focus — the work most likely to land in the next release.',
    items: [
      {
        title: 'Editor sessions and code intelligence',
        body: 'Every tab becomes its own database session, so transactions and <code>SET</code> carry between runs. Context-aware completion, parameter hints with argument names, Ctrl+click definitions, DataGrip-style colours, and exact psql-style values for every type.',
        status: 'in-progress',
      },
      {
        title: 'AI assistant on your own key',
        body: 'Real calls to OpenAI, Anthropic, Gemini or a local server, with the model list fetched live from the provider and the key sealed at rest.',
        issue: 10,
        status: 'in-progress',
      },
      {
        title: 'CLI tools management',
        body: '<b>Settings → CLI Tools</b> shows which <code>psql</code> / <code>mysql</code> / <code>mongosh</code> was found, where and which version — including installs that aren\'t on <code>PATH</code>.',
        issue: 39,
        status: 'in-progress',
      },
      {
        title: 'Dependency security sweep',
        body: 'Patched TLS, archive-extraction and build-tool dependencies across the app and the docs site.',
        issue: 185,
        status: 'in-progress',
      },
    ],
  },
  {
    id: 'next',
    label: 'Next',
    lede: 'Queued for after the current batch. Order is approximate; scope may move.',
    items: [
      {
        title: 'Refresh the database list',
        body: 'Pick up databases created or dropped on the server without reconnecting.',
        issue: 237,
      },
      {
        title: 'Master password and OS keychain',
        body: 'An optional master password mixed into the vault key, and the per-install key kept in the macOS Keychain, Windows Credential Manager or Secret Service.',
      },
      {
        title: 'SSH hardening',
        body: 'Host-key verification against <code>known_hosts</code>, and ed25519 / OpenSSH-format keys on Windows.',
      },
      {
        title: 'One design system everywhere',
        body: `Consistent primitives and palette across the app, the results grid included (${issueLink(151)}, ${issueLink(152)}, ${issueLink(187)}, ${issueLink(192)}).`,
        issue: 149,
      },
      {
        title: 'Testing infrastructure',
        body: 'Component tests and Playwright end-to-end runs on top of the unit and live-database suites.',
        issue: 24,
      },
      {
        title: 'Toolchain upgrades',
        body: 'CI on the Node 24 runtime, and the docs site on Astro 7.',
        issue: 186,
      },
    ],
  },
  {
    id: 'later',
    label: 'Later',
    lede: 'Direction, not commitment — these are problems we want to solve, not specs we\'ve written.',
    items: [
      {
        title: 'Install a previous version',
        body: 'Roll back to an earlier release from inside the app.',
        issue: 91,
        status: 'exploring',
      },
      {
        title: 'Signed and notarized builds',
        body: 'Code-signed Windows installers and notarized macOS builds, so neither OS warns on first launch.',
        status: 'exploring',
      },
      {
        title: 'Smaller, focused modules',
        body: `Split the largest components and contexts into focused pieces (${issueLink(1)}–${issueLink(6)}) and add ESLint (${issueLink(33)}).`,
        issue: 2,
        status: 'exploring',
      },
      {
        title: 'More engines',
        body: 'SQL Server, Oracle and DB2 — listed as coming soon in the connection dialog.',
        status: 'exploring',
      },
    ],
  },
];

// Closed issues that used to sit on this page.
const SHIPPED: Item[] = [
  { title: 'Universal macOS build — Intel and Apple Silicon in one .dmg', body: '', issue: 7 },
  { title: 'In-app updater on macOS', body: '', issue: 8 },
  { title: 'Keymap preset only advertises shortcuts that work', body: '', issue: 11 },
  { title: 'Per-vault random Argon2 salt', body: '', issue: 14 },
  { title: 'psql console: auto-LIMIT and \\x fixes', body: '', issue: 38 },
  { title: 'psql found from system installs instead of a broken auto-download', body: '', issue: 40 },
  { title: 'BIGINT values beyond JavaScript\'s safe range stay exact', body: '', issue: 41 },
  { title: 'Connection dialog shows every setting clearly', body: '', issue: 44 },
  { title: 'SSH tunnel reliability', body: '', issue: 46 },
  { title: 'Beta update channel', body: '', issue: 105 },
];

const STATUS_LABEL: Record<Status, string> = {
  'in-progress': 'In progress',
  'planned':     'Planned',
  'exploring':   'Exploring',
};

const issueUrl = (n: number) => `${SITE.repo}/issues/${n}`;
---
<Layout title="Roadmap · QueryDen" active="roadmap">

  <header class="page-hero">
    <SignatureMesh intensity="subtle" maskFalloff="hard" />
    <div class="wrap" style="position: relative; z-index: 1;">
      <div class="eyebrow">Where QueryDen is going</div>
      <h1 style="margin-top: 22px;">A direction, not a promise.</h1>
      <p class="lede">
        QueryDen is built by a small team in the open. This page is the
        shortest honest answer to "what are you working on?" — grouped by
        how confident we are, not by ship date.
      </p>
      <p class="rm-note">
        The source of truth is <a href={`${SITE.repo}/issues`} class="rm-src" rel="noopener">GitHub Issues</a> — every item below links back to one. Priorities shift; we'd rather move things around in public than pretend the plan never changed. Shipped work is logged in the <a href="/changelog" class="rm-src">changelog</a>.
      </p>
    </div>
  </header>

  <section class="sec-pad" id="horizons">
    <div class="wrap">

      {HORIZONS.map((h) => (
        <section class="rm-horizon" id={h.id} aria-labelledby={`h-${h.id}`}>
          <header class="rm-horizon-head">
            <h2 class="rm-horizon-title" id={`h-${h.id}`}>{h.label}</h2>
            <p class="rm-horizon-lede">{h.lede}</p>
          </header>

          <ol class="rm-list">
            {h.items.map((it) => (
              <li class="rm-item">
                <div class="rm-meta">
                  {it.status && (
                    <span class={`rm-status rm-status-${it.status}`}>{STATUS_LABEL[it.status]}</span>
                  )}
                  {it.issue !== undefined && (
                    <a class="rm-issue" href={issueUrl(it.issue)} rel="noopener" aria-label={`GitHub issue #${it.issue}`}>#{it.issue}</a>
                  )}
                </div>
                <div class="rm-body">
                  <h3 class="rm-title">{it.title}</h3>
                  <p class="rm-desc" set:html={it.body} />
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}

    </div>
  </section>

  <section class="sec-pad rm-tail">
    <div class="wrap">
      <div class="rm-tail-grid">
        <div>
          <h2 class="rm-tail-title">Recently shipped</h2>
          <p class="rm-tail-lede">
            Latest release: <a href={`${SITE.repo}/releases/tag/${RELEASE.tag}`} class="rm-src" rel="noopener">{RELEASE.tag}</a>{' '}
            on {RELEASE.publishedAt}. The <a href="/changelog" class="rm-src">changelog</a> has the version-by-version history.
          </p>
          <ul class="rm-shipped">
            {SHIPPED.map((it) => (
              <li>
                {it.issue !== undefined && (
                  <a class="rm-issue" href={issueUrl(it.issue)} rel="noopener" aria-label={`GitHub issue #${it.issue}`}>#{it.issue}</a>
                )}
                <span>{it.title}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="rm-tail-title">Disagree with the priorities?</h2>
          <p class="rm-tail-lede">
            File an <a href={`${SITE.repo}/issues/new/choose`} class="rm-src" rel="noopener">issue</a>, vote on existing ones, or start a thread in{' '}
            <a href={`${SITE.repo}/discussions`} class="rm-src" rel="noopener">Discussions</a>. We move things up the list when people ask.
          </p>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .rm-src { color: var(--ink-2); border-bottom: 1px solid var(--line-2); }
  .rm-src:hover { color: var(--ink); }

  .rm-note {
    margin-top: 28px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-3);
    max-width: 64ch;
    line-height: 1.65;
  }

  /* Horizon section */
  .rm-horizon { padding: 36px 0; border-bottom: 1px solid var(--line); }
  .rm-horizon:first-child { padding-top: 0; }
  .rm-horizon:last-child  { border-bottom: 0; }

  .rm-horizon-head { margin-bottom: 28px; }
  .rm-horizon-title {
    margin: 0 0 8px;
    font-size: 28px; font-weight: 500; letter-spacing: -0.02em; color: var(--ink);
  }
  .rm-horizon-lede {
    margin: 0; color: var(--ink-2); font-size: 14.5px; line-height: 1.6;
    max-width: 56ch;
  }

  .rm-list { list-style: none; padding: 0; margin: 0; }

  .rm-item {
    display: grid; grid-template-columns: 200px 1fr; gap: 40px;
    padding: 22px 0; border-top: 1px solid var(--line-1); align-items: start;
  }
  .rm-item:first-child { border-top: 0; padding-top: 8px; }
  @media (max-width: 800px) {
    .rm-item { grid-template-columns: 1fr; gap: 10px; }
  }

  .rm-meta {
    display: flex; flex-direction: column; gap: 8px; align-items: flex-start;
    font-family: var(--mono); font-size: 12px;
  }
  @media (max-width: 800px) {
    .rm-meta { flex-direction: row; gap: 12px; align-items: baseline; }
  }

  .rm-status {
    font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase;
    padding: 2px 8px; border-radius: 999px;
    border: 1px solid color-mix(in oklch, currentColor 30%, transparent);
    background:        color-mix(in oklch, currentColor 10%, transparent);
  }
  .rm-status-in-progress { color: var(--accent); }
  .rm-status-exploring   { color: var(--ink-3); }
  .rm-status-planned     { color: oklch(0.78 0.12 240); }

  .rm-issue {
    color: var(--ink-3);
    border-bottom: 1px solid var(--line-1);
    padding-bottom: 1px;
    transition: color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease);
  }
  .rm-issue:hover { color: var(--ink-1); border-bottom-color: var(--line-2); }

  .rm-title {
    margin: 0 0 6px;
    font-size: 17px; font-weight: 500; letter-spacing: -0.01em; color: var(--ink);
  }
  .rm-desc {
    margin: 0; color: var(--ink-2); font-size: 14.5px; line-height: 1.6;
    max-width: 64ch;
  }
  .rm-desc code {
    font-family: var(--mono); font-size: 0.88em;
    background: var(--bg-1); border: 1px solid var(--line-1);
    border-radius: 4px; padding: 1px 5px; color: var(--ink-1);
  }
  .rm-desc a {
    color: var(--ink-1); border-bottom: 1px solid var(--line-2);
    transition: color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease);
  }
  .rm-desc a:hover { color: var(--accent); border-bottom-color: var(--accent); }

  .rm-desc b { color: var(--ink-1); font-weight: 500; }

  .rm-shipped { list-style: none; padding: 0; margin: 18px 0 0; display: grid; gap: 8px; }
  .rm-shipped li {
    display: grid; grid-template-columns: 52px 1fr; gap: 12px; align-items: baseline;
    color: var(--ink-2); font-size: 14px; line-height: 1.5;
  }
  .rm-shipped .rm-issue { font-family: var(--mono); font-size: 12px; justify-self: start; }

  /* Tail callouts */
  .rm-tail { border-top: 1px solid var(--line); }
  .rm-tail-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 56px;
  }
  @media (max-width: 800px) {
    .rm-tail-grid { grid-template-columns: 1fr; gap: 32px; }
  }
  .rm-tail-title {
    margin: 0 0 10px;
    font-size: 18px; font-weight: 500; letter-spacing: -0.01em; color: var(--ink);
  }
  .rm-tail-lede {
    margin: 0; color: var(--ink-2); font-size: 14.5px; line-height: 1.65;
    max-width: 56ch;
  }
</style>
